# Copy this file to .env.prod and fill in real values before deploying with
# docker-compose.prod.yml. .env.prod is gitignored — never commit it.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=stock_scout
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=stock_scout

# --- App ---------------------------------------------------------------------
# Host port nginx (the frontend container) is published on. This is the one
# port you actually visit / point a reverse proxy at.
APP_PORT=8080
# Backend's own internal listen port — not published to the host; nginx
# reaches it over the Compose network. No reason to change this.
PORT=4000

# Which images docker-compose.prod.yml runs. Leave as-is to build locally
# from the Dockerfile, or set to tags published by CI (see .github/workflows/
# docker-publish.yml), e.g.:
#   ghcr.io/<your-github-username>/stock-scout-backend:latest
#   ghcr.io/<your-github-username>/stock-scout-frontend:latest
BACKEND_IMAGE=stock-scout-backend:local
FRONTEND_IMAGE=stock-scout-frontend:local

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
COOKIE_NAME=stock_scout_token

# Public URL you're serving this at (only matters if you put a reverse proxy
# with a different public origin in front of nginx — nginx proxying /api to
# the backend internally is same-origin from the browser's perspective, so
# CORS isn't exercised in the default setup). Auth cookies are only sent
# over HTTPS in production, so a TLS-terminating reverse proxy (Caddy,
# nginx, Traefik) in front of the frontend container is expected for any
# real deployment.
CLIENT_ORIGIN=https://your-domain.example

# --- Telegram assistant (optional — omit all four to run without it) -------
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-gmail-app-password

# --- Tuning (optional — sensible defaults apply if omitted) -----------------
# DB_POOL_MAX=20
# YAHOO_CONCURRENCY=8
# TELEGRAM_CONCURRENCY=10
